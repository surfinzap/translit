{
  "name": "translit-rue",
  "version": "4.0.0",
  "description": "Translit is a JavaScript library that transliterates the Rusyn language between the Latin alphabet and the Cyrillic script.",
  "type": "module",
  "types": "./index.d.ts",
  "license": "MIT",
  "author": {
    "name": "Braňo Šandala",
    "email": "hi@brano.me"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:dev": "vitest",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write src/ tests/",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "tests/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "main": "./dist/translit.cjs",
  "module": "./dist/translit.es.js",
  "browser": "./dist/translit.umd.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/translit.es.js",
      "require": "./dist/translit.cjs"
    }
  },
  "files": [
    "dist",
    "index.d.ts",
    "LICENSE.txt",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/surfinzap/translit-rue"
  },
  "bugs": {
    "url": "https://github.com/surfinzap/translit-rue/issues"
  },
  "keywords": [
    "transliteration",
    "Rusyn"
  ],
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
